{
  "name": "@blindspotlab/arcapush",
  "version": "0.2.2",
  "description": "Submit products, AI agents and hackathon builds to Arcapush from your terminal or MCP client.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "bin": {
    "arcapush": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "examples",
    "NOTICE",
    "LICENSE-MIT-LEGACY",
    "CHANGELOG.md",
    "docs"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mojeebdev/arcapush-cli.git"
  },
  "homepage": "https://arcapush.com",
  "bugs": {
    "url": "https://github.com/mojeebdev/arcapush-cli/issues"
  },
  "keywords": [
    "arcapush",
    "cli",
    "startup",
    "product-discovery",
    "developer-tools",
    "product-launch",
    "distribution",
    "founders",
    "mcp",
    "ai-agents"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.11",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "author": "BlindspotLab Limited"
}
